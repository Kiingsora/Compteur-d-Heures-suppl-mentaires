{
    "manifest_version": 3,
    "name": "Mon Compteur d'Heures",
    "version": "1.0",
    "description": "Extension pour gérer vos heures supplémentaires.",
    "action": {
        "default_popup": "index.html",
        "default_icon": {
            "16": "icons/icon16.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        }
    },
    "permissions": [
        "storage"
    ]
}